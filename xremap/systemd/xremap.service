[Unit]
Description=xremap keyboard remapper
PartOf=graphical-session.target
# Start after Handy and restart with it, so xremap grabs Handy's
# "handy-keys passthrough" clones instead of the physical keyboards.
After=handy.service
PartOf=handy.service

[Service]
# Wait (max 15 s) until Handy has grabbed every keyboard; start anyway after that.
ExecStartPre=/bin/sh %h/.dotfiles/xremap/systemd/wait-handy-grab.sh
ExecStart=%h/.local/bin/xremap --watch=config,device %h/.dotfiles/xremap/.config/xremap/config.yml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
