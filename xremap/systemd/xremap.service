[Unit]
Description=xremap keyboard remapper
PartOf=graphical-session.target
# Start after Handy and restart with it, so xremap grabs Handy's
# "handy-keys passthrough" clones instead of the physical keyboards.
After=handy.service
PartOf=handy.service

[Service]
# Wait (max 15 s) until Handy has grabbed every keyboard: its passthrough devices
# exist and their count is stable for 1 s. Start anyway after that.
ExecStartPre=/bin/sh -c 'p=-1; s=0; for _ in $$(seq 30); do \
  n=$$(grep -c "handy-keys passthrough: " /proc/bus/input/devices); \
  if [ "$$n" -gt 0 ] && [ "$$n" -eq "$$p" ]; then s=$$((s + 1)); [ "$$s" -ge 2 ] && exit 0; else s=0; fi; \
  p=$$n; sleep 0.5; done; exit 0'
ExecStart=%h/.local/bin/xremap --watch=config,device %h/.dotfiles/xremap/.config/xremap/config.yml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
