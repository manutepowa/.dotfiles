[Unit]
Description=Handy speech-to-text
# Handy must grab the keyboards before xremap so its push-to-talk
# shortcut is blocked from reaching the focused app. See ../README.md.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/handy --start-hidden
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
