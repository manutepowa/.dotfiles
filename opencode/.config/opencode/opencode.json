{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "agents": {
    "m3-agent": {
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "description": "M3 Agent - desarrollo y arquitectura con implementación segura",
      "system": "{file:./M3_AGENT.md}",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "share": "disabled",
  "update": "auto",
  "default_agent": "m3-agent",
  "lsp": {
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "disabled": false
    }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "settings": {
            "reasoningEffort": "medium"
          }
