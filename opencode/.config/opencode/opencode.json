  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect"
        ],
        "disabled": true
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ],
        "disabled": true
      },
      "engram": {
        "command": [
          "engram",
          "mcp",
          "--tools=agent"
        ],
        "disabled": false,
        "type": "local"
      },
      "next-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "next-devtools-mcp@latest"
        ],
        "disabled": true
      },
      "web-reader": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_reader/mcp",
        "headers": {
          "Authorization": "{env:ANTHROPIC_AUTH_TOKEN}"
        },
        "disabled": true
      },
      "web-search-prime": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
        "headers": {
          "Authorization": "{env:ANTHROPIC_AUTH_TOKEN}"
        },
        "disabled": true
      },
      "zai-mcp-server": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@z_ai/mcp-server"
        ],
        "environment": {
          "Z_AI_API_KEY": "{env:ANTHROPIC_AUTH_TOKEN}",
          "Z_AI_MODE": "ZAI"
        },
        "disabled": true
      }
    }
  }
